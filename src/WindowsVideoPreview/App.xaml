<Application x:Class="WindowsVideoPreview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowsVideoPreview"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ============================================================ -->
        <!-- LUMIEPLAYER STUDIO PRO DESIGN SYSTEM TOKENS                  -->
        <!-- ============================================================ -->

        <!-- Color Palette: Backgrounds -->
        <Color x:Key="ColorBgBase">#09090C</Color>
        <Color x:Key="ColorBgElevated">#121216</Color>
        <Color x:Key="ColorBgSurface">#18181D</Color>
        <Color x:Key="ColorBgSurfaceHover">#22222A</Color>
        <Color x:Key="ColorBgInput">#1A1A22</Color>
        <Color x:Key="ColorBgControl">#1F1F27</Color>
        <Color x:Key="ColorBgControlHover">#2C2C38</Color>
        <Color x:Key="ColorBgControlPressed">#16161D</Color>

        <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}"/>
        <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}"/>
        <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}"/>
        <SolidColorBrush x:Key="BrushBgSurfaceHover" Color="{StaticResource ColorBgSurfaceHover}"/>
        <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}"/>
        <SolidColorBrush x:Key="BrushBgControl" Color="{StaticResource ColorBgControl}"/>
        <SolidColorBrush x:Key="BrushBgControlHover" Color="{StaticResource ColorBgControlHover}"/>
        <SolidColorBrush x:Key="BrushBgControlPressed" Color="{StaticResource ColorBgControlPressed}"/>

        <!-- Color Palette: Borders -->
        <Color x:Key="ColorBorderSubtle">#25252F</Color>
        <Color x:Key="ColorBorderStrong">#3A3A4A</Color>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
        <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}"/>

        <!-- Color Palette: Accent (Studio Cyan / Sky Pro) -->
        <Color x:Key="ColorAccent">#0EA5E9</Color>
        <Color x:Key="ColorAccentHover">#38BDF8</Color>
        <Color x:Key="ColorAccentActive">#0284C7</Color>
        <Color x:Key="ColorAccentMuted">#152D42</Color>
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}"/>
        <SolidColorBrush x:Key="BrushAccentActive" Color="{StaticResource ColorAccentActive}"/>
        <SolidColorBrush x:Key="BrushAccentMuted" Color="{StaticResource ColorAccentMuted}"/>

        <!-- Color Palette: Text & Foreground -->
        <Color x:Key="ColorTextPrimary">#F4F4F6</Color>
        <Color x:Key="ColorTextSecondary">#A1A1AE</Color>
        <Color x:Key="ColorTextMuted">#717180</Color>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

        <!-- Color Palette: Semantics -->
        <Color x:Key="ColorStatusSuccess">#10B981</Color>
        <Color x:Key="ColorStatusWarning">#F59E0B</Color>
        <Color x:Key="ColorStatusDanger">#EF4444</Color>
        <SolidColorBrush x:Key="BrushStatusSuccess" Color="{StaticResource ColorStatusSuccess}"/>
        <SolidColorBrush x:Key="BrushStatusWarning" Color="{StaticResource ColorStatusWarning}"/>
        <SolidColorBrush x:Key="BrushStatusDanger" Color="{StaticResource ColorStatusDanger}"/>

