<Window x:Class="WindowsVideoPreview.Views.TimecodeJumpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jump to Timecode / Frame - LumiePlayer" 
        Icon="pack://application:,,,/favicon.png"
        Height="210" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgSurface}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Enter Timecode (hh:mm:ss.fff) or Frame number (#1234):" 
                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" x:Name="InputTextBox" 
                 Height="34" FontSize="15" FontFamily="Consolas, monospace"
                 Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushAccent}"
                 BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                 Padding="8,5" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Examples: 00:01:25.500, 85.5s, or #2500" 
                   FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,6,0,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Jump" Width="85" IsDefault="True" Click="OnJumpClick" 
                    Style="{StaticResource ControlBtn}" Background="{StaticResource BrushAccent}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="85" IsCancel="True" Click="OnCancelClick"
                    Style="{StaticResource ControlBtn}"/>
        </StackPanel>
    </Grid>
</Window>
