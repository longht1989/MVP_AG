<Window x:Class="WindowsVideoPreview.Views.HotkeySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts - LumiePlayer" 
        Icon="pack://application:,,,/favicon.png"
        Height="560" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgBase}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource BrushAccent}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="Customize Keyboard Shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            </StackPanel>
            <TextBlock Text="Click a shortcut to record new key" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Category Filter Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="FilterAllRadio" Content="All" IsChecked="True" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
            <RadioButton x:Name="FilterPlaybackRadio" Content="Playback" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
            <RadioButton x:Name="FilterNavRadio" Content="Navigation" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
            <RadioButton x:Name="FilterLoopRadio" Content="Loop" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
            <RadioButton x:Name="FilterMediaRadio" Content="Media" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
            <RadioButton x:Name="FilterViewRadio" Content="View" Style="{StaticResource SegmentedRadioBtn}" Click="OnFilterChanged"/>
        </StackPanel>

        <!-- Shortcuts Table -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="HotkeysListView" 
                      Background="Transparent" BorderThickness="0" 
                      Foreground="{StaticResource BrushTextPrimary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A2B3D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action Name -->
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Medium" FontSize="12" VerticalAlignment="Center"/>

                            <!-- Category Badge -->
                            <Border Grid.Column="1" Background="{StaticResource BrushBgControl}" CornerRadius="3" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                            </Border>

                            <!-- Shortcut Key Button / Key Recorder -->
                            <Button Grid.Column="2" 
                                    Content="{Binding KeyDisplay}" 
                                    Click="OnShortcutButtonClick"
                                    Tag="{Binding}"
                                    Style="{StaticResource ControlBtn}"
                                    Height="28"
                                    FontFamily="Consolas, monospace" FontWeight="SemiBold" FontSize="11"
                                    Foreground="{StaticResource BrushAccent}"
                                    ToolTip="Click to change shortcut"/>

                            <!-- Reset Single Action Button -->
                            <Button Grid.Column="3" 
                                    Content="↺" 
                                    Click="OnResetSingleClick"
                                    Tag="{Binding}"
                                    Style="{StaticResource ControlBtn}"
                                    Width="26" Height="26" Margin="6,0,0,0"
                                    ToolTip="Reset to default"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status & Conflict Info -->
        <TextBlock Grid.Row="3" x:Name="StatusInfoText" 
                   Text="Set A/B Loop shortcuts: Comma (,) for In, Period (.) for Out." 
                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,10"/>

        <!-- Bottom Action Bar -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Left" Content="Reset All to Defaults" Click="OnResetAllClick" 
                    Style="{StaticResource ControlBtn}" Width="150" Height="32"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save &amp; Apply" Click="OnSaveClick" 
                        Style="{StaticResource ControlBtn}" 
                        Background="{StaticResource BrushAccent}" Foreground="#FFFFFF" BorderThickness="0"
                        Width="120" Height="32" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="OnCancelClick" IsCancel="True"
                        Style="{StaticResource ControlBtn}" Width="85" Height="32"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
