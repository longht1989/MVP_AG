<UserControl x:Class="WindowsVideoPreview.Views.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64"
             Background="#101014"
             ClipToBounds="True"
             Cursor="Hand"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseLeave="OnMouseLeave"
             MouseUp="OnMouseUp">
    <Grid>
        <!-- Canvas for drawing waveform audio bars -->
        <Canvas x:Name="WaveformCanvas"/>

        <!-- Canvas for time tick lines and marks -->
        <Canvas x:Name="TicksCanvas" IsHitTestVisible="False"/>

        <!-- A-B Loop highlight rect -->
        <Rectangle x:Name="LoopRect" Fill="#33EAB308" Visibility="Collapsed" HorizontalAlignment="Left" IsHitTestVisible="False"/>

        <!-- Hover line and hover timecode pill -->
        <Line x:Name="HoverGuideLine" Y1="0" Y2="64" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="HoverPill" Background="#DD18181B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="4,1" 
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HoverTimeText" Foreground="#38BDF8" FontFamily="Consolas, monospace" FontSize="10" FontWeight="SemiBold"/>
        </Border>

        <!-- Playhead vertical line and glowing head -->
        <Line x:Name="PlayheadLine" Y1="0" Y2="64" Stroke="#EF4444" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Polygon x:Name="PlayheadIndicator" Points="0,0 8,0 4,6" Fill="#EF4444" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- Placeholder when no audio is present -->
        <TextBlock x:Name="NoAudioNotice" Text="No audio track detected in this video" Foreground="#52525B" 
                   FontSize="11" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>
