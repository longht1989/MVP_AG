<UserControl x:Class="WindowsVideoPreview.Views.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64"
             Background="{StaticResource BrushBgBase}"
             ClipToBounds="True"
             Cursor="Hand"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseLeave="OnMouseLeave"
             MouseUp="OnMouseUp">
    <Grid>
        <!-- Canvas for drawing waveform audio bars -->
        <Canvas x:Name="WaveformCanvas"/>

        <!-- Canvas for time tick lines and marks -->
        <Canvas x:Name="TicksCanvas" IsHitTestVisible="False"/>

        <!-- Canvas for A-B Loop highlight band & markers -->
        <Canvas x:Name="LoopCanvas" IsHitTestVisible="False">
            <Border x:Name="LoopBand" Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1,0,1,0" Visibility="Collapsed"/>
            <Border x:Name="LoopInMarker" Background="#F59E0B" Width="3" Height="64" CornerRadius="1" Visibility="Collapsed"/>
            <Border x:Name="LoopOutMarker" Background="#F59E0B" Width="3" Height="64" CornerRadius="1" Visibility="Collapsed"/>
        </Canvas>

        <!-- Hover line and hover timecode pill -->
        <Line x:Name="HoverGuideLine" Y1="0" Y2="64" Stroke="#55FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="HoverPill" Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="3" Padding="5,1" 
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HoverTimeText" Foreground="{StaticResource BrushAccentHover}" FontFamily="Consolas, monospace" FontSize="10" FontWeight="SemiBold"/>
        </Border>

        <!-- Playhead vertical line and glowing head -->
        <Line x:Name="PlayheadLine" Y1="0" Y2="64" Stroke="{StaticResource BrushStatusDanger}" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Polygon x:Name="PlayheadIndicator" Points="0,0 8,0 4,6" Fill="{StaticResource BrushStatusDanger}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- Placeholder when no audio is present -->
        <TextBlock x:Name="NoAudioNotice" Text="No audio track detected in this video" Foreground="{StaticResource BrushTextMuted}" 
                   FontSize="11" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>
