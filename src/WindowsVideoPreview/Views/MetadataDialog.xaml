<Window x:Class="WindowsVideoPreview.Views.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Inspector - LumiePlayer" 
        Icon="pack://application:,,,/favicon.png"
        Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#18181B"
        Foreground="#F4F4F5">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#18181B"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Media Properties &amp; Codec Inspector" 
                   FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Video A Tab -->
            <TabItem Header="Video A (Main)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="PanelA">
                        <!-- Populated in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Video B Tab -->
            <TabItem Header="Video B (Compare)" x:Name="TabB">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel x:Name="PanelB">
                        <!-- Populated in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Close" Width="100" HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#27272A" Foreground="#F4F4F5" BorderBrush="#3F3F46" Padding="12,6"
                Click="OnCloseClick"/>
    </Grid>
</Window>
