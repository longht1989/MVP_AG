<Window x:Class="WindowsVideoPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowsVideoPreview.Views"
        xmlns:converters="clr-namespace:WindowsVideoPreview.Converters"
        Title="LumiePlayer" 
        Icon="pack://application:,,,/favicon.png"
        Height="860" Width="1400"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgBase}"
        Foreground="{StaticResource BrushTextPrimary}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>

        <!-- Custom Dark Slider Style -->
        <Style x:Key="ModernTimelineSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent" Height="24">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource BrushAccent}" Height="6" CornerRadius="3,0,0,3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{StaticResource BrushBgControl}" Height="6" CornerRadius="0,3,3,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Menu / Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Center Video + Playlist -->
            <RowDefinition Height="*"/>
            <!-- 2: Timeline + Waveform + Controls -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Menu Items & Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/favicon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="LUMIE PLAYER" FontWeight="Black" FontSize="13" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Open Video A -->
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding OpenFileACommand}" ToolTip="Open Video A (Ctrl+O)" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Video A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Open Video B -->
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding OpenFileBCommand}" ToolTip="Open Video B (Ctrl+Shift+O)" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Video B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource BrushBorderSubtle}" Margin="4,0,8,0"/>

                    <!-- Compare Mode Switch -->
                    <ToggleButton IsChecked="{Binding IsCompareMode, Mode=TwoWay}" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,6,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="tbBorder" Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,4" Height="30">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconCompare}" Width="13" Height="13" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,6,0" x:Name="tbIcon"/>
                                                    <TextBlock Text="Compare: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="tbStatus" Text="OFF" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="tbBorder" Property="Background" Value="{StaticResource BrushAccentMuted}"/>
                                                    <Setter TargetName="tbBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                    <Setter TargetName="tbIcon" Property="Fill" Value="{StaticResource BrushAccent}"/>
                                                    <Setter TargetName="tbStatus" Property="Text" Value="ON"/>
                                                    <Setter TargetName="tbStatus" Property="Foreground" Value="{StaticResource BrushAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tbBorder" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Compare Mode Sub-Layout (Side by Side vs Split Wipe) -->
                    <Border Background="{StaticResource BrushBgBase}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,8,0"
                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}" Height="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="Side by Side"
                                         IsChecked="{Binding IsSideBySide, Mode=OneWay}"
                                         Command="{Binding SetCompareLayoutCommand}" CommandParameter="SideBySide" Margin="2,0"/>
                            <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="Split Wipe"
                                         IsChecked="{Binding IsOverlay, Mode=OneWay}"
                                         Command="{Binding SetCompareLayoutCommand}" CommandParameter="Overlay" Margin="2,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Split Wipe Controls in Top Bar -->
                    <Border Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,8,0" Height="30"
                            Visibility="{Binding IsOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wipe: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OverlayOpacity, StringFormat='{}{0:P0}'}" Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="11" Width="36" VerticalAlignment="Center"/>
                            <Slider Width="70" Minimum="0.0" Maximum="1.0" Value="{Binding OverlayOpacity, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="100% A" Style="{StaticResource CompactControlBtn}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.0" Margin="2,0" ToolTip="Show 100% Video A"/>
                            <Button Content="50%" Style="{StaticResource CompactControlBtn}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.5" Margin="2,0" ToolTip="50% Split Video A &amp; B"/>
                            <Button Content="100% B" Style="{StaticResource CompactControlBtn}" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="1.0" Margin="2,0" ToolTip="Show 100% Video B"/>
                            <Button Style="{StaticResource CompactControlBtn}" ToolTip="Hold to see Video A, release to see Video B (Tab)" 
                                    PreviewMouseDown="OnFlipMouseDown" PreviewMouseUp="OnFlipMouseUp" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFlip}" Width="12" Height="12" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Text="Flip [Tab]" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding SaveCompareSessionCommand}" ToolTip="Save Compare Session (Files, Offset, Time)" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSave}" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Save Session" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding LoadCompareSessionCommand}" ToolTip="Load Saved Compare Session" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Load Session" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Menu Items -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsWaveformVisible, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Margin="2,0" ToolTip="Toggle Audio Waveform (W)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconWaveform}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Waveform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding IsPlaylistVisible, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Margin="2,0" ToolTip="Toggle Playlist Panel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPlaylist}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Playlist" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource ToolbarBtn}" Click="OnShowMetadataClick" ToolTip="View Detailed Media Metadata" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconInspector}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Inspector" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Toggle Fullscreen (F)" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFullscreen}" Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Fullscreen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER AREA: PLAYLIST + VIDEO DISPLAY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Playlist Column (collapsible) -->
                <ColumnDefinition Width="260" x:Name="PlaylistColDef"/>
                <!-- Splitter -->
                <ColumnDefinition Width="Auto" x:Name="PlaylistSplitterColDef"/>
                <!-- Video Players Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PLAYLIST PANEL -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgBase}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Playlist Header -->
                    <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" Padding="12,8" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlaylist}" Width="14" Height="14" Fill="{StaticResource BrushAccent}" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Playlist" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                <Border Background="{StaticResource BrushBgControl}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Playlist.Count}" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button ToolTip="Add video files to playlist" Width="26" Height="24" Style="{StaticResource ControlBtn}" Command="{Binding AddFilesCommand}" Margin="0,0,4,0" Padding="0">
                                    <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform"/>
                                </Button>
                                <Button ToolTip="Clear entire playlist" Width="26" Height="24" Style="{StaticResource ControlBtn}" Command="{Binding ClearPlaylistCommand}" Padding="0">
                                    <Path Data="{StaticResource IconClear}" Width="11" Height="11" Fill="{StaticResource BrushStatusDanger}" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Playlist ListBox with Internal Drag Support -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrushTextPrimary}"
                             MouseDoubleClick="OnPlaylistDoubleClick" AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
                             PreviewMouseLeftButtonDown="OnPlaylistPreviewMouseDown" PreviewMouseMove="OnPlaylistPreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="4" Margin="2,1" Cursor="Hand" Background="Transparent" x:Name="itemBorder">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconFilm}" Width="14" Height="14" Fill="{StaticResource BrushTextMuted}" Stretch="Uniform" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{StaticResource BrushBgControl}" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Resolution}" FontSize="9" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{StaticResource BrushBgControl}" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding FpsText}" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Playlist Footer -->
                    <Border Grid.Row="2" Background="{StaticResource BrushBgSurface}" Padding="8,6" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ControlBtn}" Command="{Binding SavePlaylistCommand}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSave}" Width="12" Height="12" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Text="Save..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ControlBtn}" Command="{Binding LoadPlaylistCommand}" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolder}" Width="12" Height="12" Fill="{StaticResource BrushTextSecondary}" Stretch="Uniform" Margin="0,0,4,0"/>
                                    <TextBlock Text="Load..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter between Playlist and Videos -->
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BrushBgSurface}" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- VIDEO RENDERING AREA: Dynamic Single / Compare (Side-by-Side & Overlay Stack) -->
            <Grid Grid.Column="2" Background="#0A0A0C" x:Name="VideoAreaGrid">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Video A (Single & Side-by-Side Left) -->
                    <ColumnDefinition Width="*" x:Name="ColVideoA"/>
                    <!-- Column 1: Splitter (Side-by-Side only) -->
                    <ColumnDefinition Width="Auto" x:Name="ColVideoSplitter"/>
                    <!-- Column 2: Video B (Side-by-Side Right) -->
                    <ColumnDefinition Width="*" x:Name="ColVideoB"/>
                </Grid.ColumnDefinitions>

                <!-- Video A Player -->
                <views:VideoPlayerControl Grid.Column="0" x:Name="PlayerAControl" RoleName="VIDEO A (REFERENCE)"/>

                <!-- Compare Splitter (Side-by-Side only) -->
                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BrushBorderSubtle}" ResizeBehavior="PreviousAndNext"
                              x:Name="CompareSplitter" Visibility="Collapsed"/>

                <!-- Video B Player (Dynamically positioned in Column 2 for Side-by-Side or Column 0 for Overlay) -->
                <views:VideoPlayerControl Grid.Column="2" x:Name="PlayerBControl" RoleName="VIDEO B (COMPARISON)" ShowCloseButton="True"
                                          Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- BOTTOM CONTROLS & TIMELINE -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8,16,10">
            <StackPanel>
                <!-- WAVEFORM AUDIO BAR (TOGGLEABLE) -->
                <Border Margin="0,0,0,6" CornerRadius="4" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                        Visibility="{Binding IsWaveformVisible, Converter={StaticResource BoolToVis}}">
                    <views:WaveformControl x:Name="MainWaveform"
                                           WaveformData="{Binding WaveformData}"
                                           Position="{Binding Position}"
                                           Duration="{Binding Duration}"
                                           LoopStart="{Binding LoopStart}"
                                           LoopEnd="{Binding LoopEnd}"
                                           SeekRequested="OnWaveformSeekRequested"/>
                </Border>

                <!-- TIMELINE SLIDER + TIMECODES ROW -->
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Timecode A (Clickable for Jump) -->
                    <Button Grid.Column="0" ToolTip="Click to Jump to Timecode/Frame" Click="OnJumpTimecodeClick"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimecodeA}" FontFamily="Consolas, monospace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="{Binding FrameTextA, StringFormat='  [{0}]'}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Scrub Slider Container with Full Hit-Test Surface -->
                    <Grid Grid.Column="1" x:Name="TimelineGrid" Margin="16,0" VerticalAlignment="Center" Height="28" 
                          Background="Transparent" Cursor="Hand"
                          PreviewMouseDown="OnTimelinePreviewMouseDown" 
                          PreviewMouseMove="OnTimelinePreviewMouseMove" 
                          PreviewMouseUp="OnTimelinePreviewMouseUp">
                        <Slider x:Name="TimelineSlider" Style="{StaticResource ModernTimelineSlider}" 
                                Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=TwoWay}" 
                                VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Right Info: Compare Timecode B & Total Duration -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Video B Timecode in Compare Mode -->
                        <Border Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Padding="6,2" CornerRadius="4" Margin="0,0,10,0"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B: " Foreground="{StaticResource BrushStatusWarning}" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding TimecodeB}" FontFamily="Consolas, monospace" FontSize="13" Foreground="#FDE047"/>
                                <TextBlock Text="{Binding FrameTextB, StringFormat='  ({0})'}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Duration -->
                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:F1}s'}" FontFamily="Consolas, monospace" FontSize="14" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- TRANSPORT CONTROLS ROW -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Loop Controls -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center: Playback & Frame Stepping -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Audio, Offset & Utilities -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: A-B Loop Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarBtn}" Height="26" Padding="6,2" Command="{Binding SetLoopACommand}" ToolTip="Set Loop Start (A) [key: [ ]">
                                    <TextBlock Text="[ Loop A" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarBtn}" Height="26" Padding="6,2" Command="{Binding SetLoopBCommand}" ToolTip="Set Loop End (B) [key: ] ]">
                                    <TextBlock Text="Loop B ]" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarBtn}" Height="26" Padding="5,2" Command="{Binding ClearLoopCommand}" ToolTip="Clear A-B Loop [key: \]">
                                    <Path Data="{StaticResource IconClear}" Width="10" Height="10" Fill="{StaticResource BrushStatusDanger}" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LoopSummaryText}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Playback & Frame Stepping -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Rewind -5s -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="-5" ToolTip="Rewind 5s" Margin="2,0" Padding="7,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSeekBackward5}" Width="12" Height="12" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,3,0"/>
                                <TextBlock Text="-5s" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Rewind -1s -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="-1" ToolTip="Rewind 1s (Shift+Left)" Margin="2,0" Padding="6,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSeekBackward1}" Width="11" Height="11" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,2,0"/>
                                <TextBlock Text="-1s" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Frame Backward -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding FrameStepBackwardCommand}" ToolTip="Previous Frame (Left Arrow)" Margin="3,0" Padding="7,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStepBackward}" Width="12" Height="12" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Frame" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Primary Play/Pause Button with dynamic Vector icon! -->
                        <Button Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryPlayBtn}" Margin="6,0" ToolTip="Play / Pause (Space)">
                            <Path Width="16" Height="16" Fill="#FFFFFF" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconPlay}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconPause}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Frame Forward -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding FrameStepForwardCommand}" ToolTip="Next Frame (Right Arrow)" Margin="3,0" Padding="7,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Frame" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Path Data="{StaticResource IconStepForward}" Width="12" Height="12" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform"/>
                            </StackPanel>
                        </Button>

                        <!-- Forward +1s -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="1" ToolTip="Forward 1s (Shift+Right)" Margin="2,0" Padding="6,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+1s" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <Path Data="{StaticResource IconSeekForward1}" Width="11" Height="11" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform"/>
                            </StackPanel>
                        </Button>

                        <!-- Forward +5s -->
                        <Button Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="5" ToolTip="Forward 5s" Margin="2,0" Padding="7,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+5s" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <Path Data="{StaticResource IconSeekForward5}" Width="12" Height="12" Fill="{StaticResource BrushTextPrimary}" Stretch="Uniform"/>
                            </StackPanel>
                        </Button>

                        <!-- Speed Selector -->
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Speed:" Foreground="{StaticResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox SelectedValue="{Binding PlaybackSpeed, Mode=TwoWay}" SelectedValuePath="Tag" Width="68" Height="28"
                                      Style="{StaticResource ModernStudioComboBox}">
                                <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Compare Offset & Audio & Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Compare Offset Controls -->
                        <Border Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" Height="30"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Offset B: " Foreground="{StaticResource BrushStatusWarning}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OffsetSeconds, StringFormat='{}{0:+0.000;-0.000;0.000}s'}" FontFamily="Consolas, monospace" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>

                                <Button Content="-0.1s" Style="{StaticResource CompactControlBtn}" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.1" Margin="1,0"/>
                                <Button Content="-0.01s" Style="{StaticResource CompactControlBtn}" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.01" Margin="1,0"/>
                                <Button Content="+0.01s" Style="{StaticResource CompactControlBtn}" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.01" Margin="1,0"/>
                                <Button Content="+0.1s" Style="{StaticResource CompactControlBtn}" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.1" Margin="1,0"/>
                                <Button Content="0" Style="{StaticResource CompactControlBtn}" Command="{Binding ResetOffsetCommand}" ToolTip="Reset offset to 0" Margin="1,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Source Segmented Group -->
                        <Border Background="{StaticResource BrushBgControl}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,10,0" Height="30"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Audio:" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="4,0,2,0" VerticalAlignment="Center"/>
                                <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="A" x:Name="RbAudioA" IsChecked="True"
                                             GroupName="AudioSrc" Click="OnAudioSourceAClick" Margin="1,0"/>
                                <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="B" x:Name="RbAudioB"
                                             GroupName="AudioSrc" Click="OnAudioSourceBClick" Margin="1,0"/>
                                <RadioButton Style="{StaticResource SegmentedRadioBtn}" Content="Mute" x:Name="RbAudioMute"
                                             GroupName="AudioSrc" Click="OnAudioSourceMuteClick" Margin="1,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Volume Mute Button with dynamic vector icon! -->
                        <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Width="28" Height="28" Padding="0" Margin="0,0,2,0" ToolTip="Toggle Mute (M)">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource IconVolume}"/>
                                        <Setter Property="Fill" Value="{StaticResource BrushTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconMute}"/>
                                                <Setter Property="Fill" Value="{StaticResource BrushStatusDanger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                        <Slider Width="70" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,4,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgBase}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Shortcuts: [Space] Play/Pause | [←/→] Step Frame | [Shift+←/→] ±1s | [Tab] Flip Wipe | [F] Fullscreen | [W] Waveform" 
                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
