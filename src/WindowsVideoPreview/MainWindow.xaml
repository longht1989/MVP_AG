<Window x:Class="WindowsVideoPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WindowsVideoPreview.Views"
        xmlns:converters="clr-namespace:WindowsVideoPreview.Converters"
        Title="LumiePlayer" 
        Icon="pack://application:,,,/favicon.png"
        Height="860" Width="1400"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12"
        Foreground="#F4F4F5"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewKeyUp="OnWindowPreviewKeyUp">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>

        <!-- Custom Dark Slider Style -->
        <Style x:Key="ModernTimelineSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent" Height="24">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#38BDF8" Height="6" CornerRadius="3,0,0,3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#27272A" Height="6" CornerRadius="0,3,3,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#38BDF8" StrokeThickness="2" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarBtn" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ControlBtn" TargetType="ButtonBase">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#2E2E38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E38"/>
                    <Setter Property="BorderBrush" Value="#3F3F4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Menu / Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Center Video + Playlist -->
            <RowDefinition Height="*"/>
            <!-- 2: Timeline + Waveform + Controls -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#141418" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Menu Items & Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/favicon.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="LUMIE PLAYER" FontWeight="Black" FontSize="14" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="📂 Open Video A (Ctrl+O)" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenFileACommand}"/>
                    <Button Content="📂 Open Video B (Ctrl+Shift+O)" Style="{StaticResource ToolbarBtn}" Command="{Binding OpenFileBCommand}"/>

                    <Border Width="1" Height="18" Background="#27272A" Margin="8,0"/>

                    <!-- Compare Mode Switch -->
                    <ToggleButton IsChecked="{Binding IsCompareMode, Mode=TwoWay}" Cursor="Hand" VerticalAlignment="Center" Margin="4,0" Padding="10,5">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="tbBorder" Background="#1E1E24" BorderBrush="#2E2E38" BorderThickness="1" CornerRadius="4" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚡ Compare: " Foreground="#A1A1AA" FontSize="12"/>
                                                    <TextBlock x:Name="tbStatus" Text="OFF" Foreground="#EF4444" FontWeight="Bold" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="tbBorder" Property="Background" Value="#1E3A8A"/>
                                                    <Setter TargetName="tbBorder" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter TargetName="tbStatus" Property="Text" Value="ON"/>
                                                    <Setter TargetName="tbStatus" Property="Foreground" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Compare Mode Sub-Layout (Side by Side vs Split Wipe) -->
                    <Border Background="#18181E" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="2" Margin="4,0"
                            Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Side by Side" IsChecked="{Binding IsSideBySide, Mode=OneWay}"
                                         Command="{Binding SetCompareLayoutCommand}" CommandParameter="SideBySide"
                                         Foreground="#F4F4F5" FontSize="11" Margin="6,2" VerticalAlignment="Center"/>
                            <RadioButton Content="Split Wipe" IsChecked="{Binding IsOverlay, Mode=OneWay}"
                                         Command="{Binding SetCompareLayoutCommand}" CommandParameter="Overlay"
                                         Foreground="#38BDF8" FontSize="11" Margin="6,2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Split Wipe Controls in Top Bar -->
                    <Border Background="#1E1E24" CornerRadius="4" Padding="8,3" Margin="4,0"
                            Visibility="{Binding IsOverlay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wipe (A|B): " Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OverlayOpacity, StringFormat='{}{0:P0}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Width="36" VerticalAlignment="Center"/>
                            <Slider Width="70" Minimum="0.0" Maximum="1.0" Value="{Binding OverlayOpacity, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="100% A" Style="{StaticResource ControlBtn}" Padding="4,1" FontSize="10" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.0" Margin="2,0" ToolTip="Show 100% Video A"/>
                            <Button Content="50% Split" Style="{StaticResource ControlBtn}" Padding="4,1" FontSize="10" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="0.5" Margin="2,0" ToolTip="50% Video A (Left) / 50% Video B (Right)"/>
                            <Button Content="100% B" Style="{StaticResource ControlBtn}" Padding="4,1" FontSize="10" Command="{Binding SetOverlayOpacityCommand}" CommandParameter="1.0" Margin="2,0" ToolTip="Show 100% Video B"/>
                            <Button Content="Flip [Tab]" Style="{StaticResource ControlBtn}" Padding="4,1" FontSize="10" ToolTip="Hold to see Video A, release to see Video B" 
                                    PreviewMouseDown="OnFlipMouseDown" PreviewMouseUp="OnFlipMouseUp" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="💾 Save Session" Style="{StaticResource ToolbarBtn}" Command="{Binding SaveCompareSessionCommand}" ToolTip="Save Compare Session (Files, Offset, Time)"/>
                    <Button Content="📂 Load Session" Style="{StaticResource ToolbarBtn}" Command="{Binding LoadCompareSessionCommand}" ToolTip="Load Saved Compare Session"/>
                </StackPanel>

                <!-- Right Menu Items -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsWaveformVisible, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Margin="4,0" ToolTip="Toggle Audio Waveform (W)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="〰 Waveform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding IsPlaylistVisible, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Margin="4,0" ToolTip="Toggle Playlist Panel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📑 Playlist" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Content="ℹ Inspector" Style="{StaticResource ToolbarBtn}" Click="OnShowMetadataClick" ToolTip="View Detailed Media Metadata"/>
                    <Button Content="⛶ Fullscreen (F)" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleFullscreenCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CENTER AREA: PLAYLIST + VIDEO DISPLAY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Playlist Column (collapsible) -->
                <ColumnDefinition Width="260" x:Name="PlaylistColDef"/>
                <!-- Splitter -->
                <ColumnDefinition Width="Auto" x:Name="PlaylistSplitterColDef"/>
                <!-- Video Players Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PLAYLIST PANEL -->
            <Border Grid.Column="0" Background="#131317" BorderBrush="#27272A" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Playlist Header -->
                    <Border Grid.Row="0" Background="#18181E" Padding="10,8" BorderBrush="#27272A" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Playlist" FontWeight="Bold" FontSize="13" Foreground="#F4F4F5"/>
                                <TextBlock Text="{Binding Playlist.Count, StringFormat=' ({0})'}" Foreground="#71717A" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="+" ToolTip="Add files" Width="26" Height="24" Style="{StaticResource ControlBtn}" Command="{Binding AddFilesCommand}" Margin="0,0,4,0"/>
                                <Button Content="✕" ToolTip="Clear playlist" Width="26" Height="24" Style="{StaticResource ControlBtn}" Command="{Binding ClearPlaylistCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Playlist ListBox with Internal Drag Support -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedPlaylistItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Foreground="#E4E4E7"
                             MouseDoubleClick="OnPlaylistDoubleClick" AllowDrop="True" Drop="OnPlaylistDrop" DragOver="OnPlaylistDragOver"
                             PreviewMouseLeftButtonDown="OnPlaylistPreviewMouseDown" PreviewMouseMove="OnPlaylistPreviewMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="4" Margin="2,1" Cursor="Hand" Background="Transparent">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="12" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Resolution}" FontSize="10" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FpsText}" FontSize="10" Foreground="#A1A1AA" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="#71717A"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Playlist Footer -->
                    <Border Grid.Row="2" Background="#18181E" Padding="8,6" BorderBrush="#27272A" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save..." Style="{StaticResource ControlBtn}" Command="{Binding SavePlaylistCommand}" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Load..." Style="{StaticResource ControlBtn}" Command="{Binding LoadPlaylistCommand}" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter between Playlist and Videos -->
            <GridSplitter Grid.Column="1" Width="4" Background="#1E1E24" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- VIDEO RENDERING AREA: Dynamic Single / Compare (Side-by-Side & Overlay Stack) -->
            <Grid Grid.Column="2" Background="#0A0A0C" x:Name="VideoAreaGrid">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Video A (Single & Side-by-Side Left) -->
                    <ColumnDefinition Width="*" x:Name="ColVideoA"/>
                    <!-- Column 1: Splitter (Side-by-Side only) -->
                    <ColumnDefinition Width="Auto" x:Name="ColVideoSplitter"/>
                    <!-- Column 2: Video B (Side-by-Side Right) -->
                    <ColumnDefinition Width="*" x:Name="ColVideoB"/>
                </Grid.ColumnDefinitions>

                <!-- Video A Player -->
                <views:VideoPlayerControl Grid.Column="0" x:Name="PlayerAControl" RoleName="VIDEO A (REFERENCE)"/>

                <!-- Compare Splitter (Side-by-Side only) -->
                <GridSplitter Grid.Column="1" Width="4" Background="#27272A" ResizeBehavior="PreviousAndNext"
                              x:Name="CompareSplitter" Visibility="Collapsed"/>

                <!-- Video B Player (Dynamically positioned in Column 2 for Side-by-Side or Column 0 for Overlay) -->
                <views:VideoPlayerControl Grid.Column="2" x:Name="PlayerBControl" RoleName="VIDEO B (COMPARISON)" ShowCloseButton="True"
                                          Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- BOTTOM CONTROLS & TIMELINE -->
        <Border Grid.Row="2" Background="#141418" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="16,8,16,12">
            <StackPanel>
                <!-- WAVEFORM AUDIO BAR (TOGGLEABLE) -->
                <Border Margin="0,0,0,6" CornerRadius="4" BorderBrush="#27272A" BorderThickness="1"
                        Visibility="{Binding IsWaveformVisible, Converter={StaticResource BoolToVis}}">
                    <views:WaveformControl x:Name="MainWaveform"
                                           WaveformData="{Binding WaveformData}"
                                           Position="{Binding Position}"
                                           Duration="{Binding Duration}"
                                           LoopStart="{Binding LoopStart}"
                                           LoopEnd="{Binding LoopEnd}"
                                           SeekRequested="OnWaveformSeekRequested"/>
                </Border>

                <!-- TIMELINE SLIDER + TIMECODES ROW -->
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Timecode A (Clickable for Jump) -->
                    <Button Grid.Column="0" ToolTip="Click to Jump to Timecode/Frame" Click="OnJumpTimecodeClick"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TimecodeA}" FontFamily="Consolas, monospace" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding FrameTextA, StringFormat='  [{0}]'}" FontFamily="Consolas, monospace" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Scrub Slider Container with Full Hit-Test Surface -->
                    <Grid Grid.Column="1" x:Name="TimelineGrid" Margin="16,0" VerticalAlignment="Center" Height="28" 
                          Background="Transparent" Cursor="Hand"
                          PreviewMouseDown="OnTimelinePreviewMouseDown" 
                          PreviewMouseMove="OnTimelinePreviewMouseMove" 
                          PreviewMouseUp="OnTimelinePreviewMouseUp">
                        <Slider x:Name="TimelineSlider" Style="{StaticResource ModernTimelineSlider}" 
                                Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=TwoWay}" 
                                VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Right Info: Compare Timecode B & Total Duration -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Video B Timecode in Compare Mode -->
                        <Border Background="#1E1E24" Padding="6,2" CornerRadius="4" Margin="0,0,10,0"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B: " Foreground="#EAB308" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="{Binding TimecodeB}" FontFamily="Consolas, monospace" FontSize="13" Foreground="#FDE047"/>
                                <TextBlock Text="{Binding FrameTextB, StringFormat='  ({0})'}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#A1A1AA"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Duration -->
                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:F1}s'}" FontFamily="Consolas, monospace" FontSize="14" Foreground="#71717A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- TRANSPORT CONTROLS ROW -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Loop Controls -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center: Playback & Frame Stepping -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Audio, Offset & Utilities -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: A-B Loop Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="[ Loop A" Style="{StaticResource ControlBtn}" Command="{Binding SetLoopACommand}" ToolTip="Set Loop Start (A)" Margin="0,0,4,0"/>
                        <Button Content="Loop B ]" Style="{StaticResource ControlBtn}" Command="{Binding SetLoopBCommand}" ToolTip="Set Loop End (B)" Margin="0,0,4,0"/>
                        <Button Content="✕ Clear" Style="{StaticResource ControlBtn}" Command="{Binding ClearLoopCommand}" ToolTip="Clear A-B Loop" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding LoopSummaryText}" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Prev Frame, Seek, Play/Pause, Next Frame -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="⏪ -5s" Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="-5" ToolTip="Rewind 5s" Margin="2,0"/>
                        <Button Content="◀ -1s" Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="-1" ToolTip="Rewind 1s (Shift+Left)" Margin="2,0"/>
                        <Button Content="⏮ Frame" Style="{StaticResource ControlBtn}" Command="{Binding FrameStepBackwardCommand}" ToolTip="Previous Frame (Left Arrow)" Margin="4,0" FontWeight="SemiBold"/>

                        <!-- Big Play/Pause Button -->
                        <Button Command="{Binding PlayPauseCommand}" Width="60" Height="36" Margin="6,0" Cursor="Hand" ToolTip="Play / Pause (Space)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding PlayPauseIcon}" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                        </Button>

                        <Button Content="Frame ⏭" Style="{StaticResource ControlBtn}" Command="{Binding FrameStepForwardCommand}" ToolTip="Next Frame (Right Arrow)" Margin="4,0" FontWeight="SemiBold"/>
                        <Button Content="+1s ▶" Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="1" ToolTip="Forward 1s (Shift+Right)" Margin="2,0"/>
                        <Button Content="+5s ⏩" Style="{StaticResource ControlBtn}" Command="{Binding SeekRelativeCommand}" CommandParameter="5" ToolTip="Forward 5s" Margin="2,0"/>

                        <!-- Speed Selector -->
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Speed:" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox SelectedValue="{Binding PlaybackSpeed, Mode=TwoWay}" SelectedValuePath="Tag" Width="70"
                                      Background="#18181E" Foreground="#F4F4F5" BorderBrush="#27272A">
                                <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Compare Offset & Audio & Volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Compare Offset Controls (Visible only in compare mode) -->
                        <Border Background="#1E1E24" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Offset B: " Foreground="#EAB308" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OffsetSeconds, StringFormat='{}{0:+0.000;-0.000;0.000}s'}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                <Button Content="-0.1s" Style="{StaticResource ControlBtn}" Padding="4,2" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.1" Margin="1,0"/>
                                <Button Content="-0.01s" Style="{StaticResource ControlBtn}" Padding="4,2" Command="{Binding AdjustOffsetCommand}" CommandParameter="-0.01" Margin="1,0"/>
                                <Button Content="+0.01s" Style="{StaticResource ControlBtn}" Padding="4,2" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.01" Margin="1,0"/>
                                <Button Content="+0.1s" Style="{StaticResource ControlBtn}" Padding="4,2" Command="{Binding AdjustOffsetCommand}" CommandParameter="0.1" Margin="1,0"/>
                                <Button Content="0" Style="{StaticResource ControlBtn}" Padding="4,2" Command="{Binding ResetOffsetCommand}" ToolTip="Reset offset to 0" Margin="1,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Source Selection in Compare Mode -->
                        <Border Background="#1E1E24" CornerRadius="4" Padding="6,4" Margin="0,0,12,0"
                                Visibility="{Binding IsCompareMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Audio: " Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center"/>
                                <RadioButton Content="A" x:Name="RbAudioA" IsChecked="True"
                                             GroupName="AudioSrc" Click="OnAudioSourceAClick" Foreground="#38BDF8" Margin="4,0" VerticalAlignment="Center"/>
                                <RadioButton Content="B" x:Name="RbAudioB" GroupName="AudioSrc" Click="OnAudioSourceBClick" Foreground="#FDE047" Margin="4,0" VerticalAlignment="Center"/>
                                <RadioButton Content="Mute" x:Name="RbAudioMute" GroupName="AudioSrc" Click="OnAudioSourceMuteClick" Foreground="#EF4444" Margin="4,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Volume Slider -->
                        <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}" Style="{StaticResource ToolbarBtn}" Padding="4" ToolTip="Toggle Mute (M)">
                            <TextBlock Text="{Binding MuteIcon}" FontSize="13"/>
                        </ToggleButton>
                        <Slider Width="70" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0C0C0E" BorderBrush="#1C1C20" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Shortcuts: [Space] Play/Pause | [←/→] Step Frame | [Shift+←/→] ±1s | [Tab] Flip Overlay | [F] Fullscreen | [W] Waveform" 
                               FontSize="11" Foreground="#52525B"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
